{
  "$schema": "https://raw.githubusercontent.com/microsoft/AL-Go-Actions/v9.2/.Modules/settings.schema.json",
  "type": "PTE",
  "templateUrl": "https://github.com/microsoft/AL-Go-PTE@main",
  "trackALAlertsInGitHub": true,
  "enableCodeCop": true,
  "enableUICop": true,
  "failOn": "error",
  "environments": [
    "PROD",
    "TEST"
  ],
  "DeployToTEST": {
    "EnvironmentName": "Sandbox_ThangNT",
    "continuousDeployment": false,
    "Branches": [
      "main"
    ]
  },
  "TEST-AuthContextSecretName": "ALGOPROJECTAPP_AUTHCONTEXT",
  "_businessAreas": "Business areas the customer uses, for the functional upgrade report (AnalyticsUpgradeChanges workflow). Areas the customization touches are derived from the AL source automatically; list here the ones the customer uses WITHOUT customization - they still need UAT. Values are Business Central namespace segments; diff_symbols.py rollup warns on any name it cannot find.",
  "businessAreas": [
    "Sales",
    "Service",
    "Integration",
    "Inventory",
    "Purchases",
    "Foundation",
    "Warehouse",
    "Finance",
    "Bank"
  ],
  "DeployToPROD": {
    "EnvironmentName": "Production",
    "continuousDeployment": false
  },
  "PROD-AuthContextSecretName": "ALGOPROJECTAPPPROD_AUTHCONTEXT",
  "templateSha": "b7dd1f32feb254e07086096e8970fba1187d9a6e"
}
